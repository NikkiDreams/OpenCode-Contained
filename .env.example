# Copy this file to .env (git-ignored) and fill it in before running web mode.
#
# Required for web mode. An empty value makes compose and run.sh refuse to
# start, because the OpenCode web UI would otherwise have no authentication.
# Generate a real value with:
#   openssl rand -hex 24
OPENCODE_SERVER_PASSWORD=

# Optional. Defaults are shown; uncomment to override.
#OPENCODE_SERVER_USERNAME=opencode
# Host port for the web UI.
#OPENCODE_PORT=4096
# Bind address for the web UI. 127.0.0.1 keeps it local; 0.0.0.0 publishes it
# to your network (host networking means every LAN device can reach it).
#OPENCODE_BIND=127.0.0.1
# GitHub token for `gh` and the GitHub MCP server.
#GH_TOKEN=
# Helper script only (run.sh): project directory, image, uid/gid mapping.
#PROJECT_PATH=~/code
#OC_IMAGE=ghcr.io/nikkidreams/opencode-contained:latest
#CUSTOM_UID=1000
#CUSTOM_GID=1000
