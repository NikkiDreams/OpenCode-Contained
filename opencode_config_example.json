{
    "$schema": "https://opencode.ai/config.json",
    "update": "notify",
    "shell": "/usr/bin/bash",
    "share": "disabled",
    "compaction": {
        "auto": true,
        "buffer": "20%",
        "keep": {
            "tokens": 24000
        }
    },
    "providers": {
        "strata": {
            "name": "Strata (local)",
            "package": "@ai-sdk/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:8080/v1",
                "apiKey": "{env:STRATA_API_KEY}"
            },
            "models": {
                "swift-1.5-iq3_xxs": {
                    "name": "Swift 1.5 iq3_xxs(local)",
                    "settings": {
                        "tool_call": true,
                        "reasoning": true,
                        "limit": {
                            "context": 131072,
                            "input": 126976,
                            "output": 4096
                        }
                    },
                },
                "qwen3.8-flash-next-coder-iq1_m": {
                    "name": "Qwen3.8 iq1_m Coder (local)",
                    "settings": {
                        "tool_call": true,
                        "reasoning": true,
                        "limit": {
                            "context": 131072,
                            "input": 126976,
                            "output": 4096
                        }
                    },
                },
                "qwen3.8-flash-next-iq3_xxs": {
                    "name": "Qwen3.8-Flash-Next (local)",
                    "settings": {
                        "tool_call": true,
                        "reasoning": true,
                        "limit": {
                            "context": 131072,
                            "input": 126976,
                            "output": 4096
                        }
                    },
                }
            }
        }
    },
    "plugins": [
        "superpowers@git+https://github.com/obra/superpowers.git"
    ],
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
                "oauth": false,
                "headers": {
                    "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
                }
            },
            "github": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@modelcontextprotocol/server-github"
                ]
            }
        }
    }
}